{"version":3,"term":{"cols":80,"rows":24},"timestamp":1780925843,"idle_time_limit":2.0,"command":"uv run bash docs/demo/tutorial.sh","title":"prompiler — first spec in under 15 minutes","env":{"SHELL":"/bin/zsh"}}
[0.030, "o", "\u001b[2m# 1. Install — verify prompiler is on PATH.\u001b[0m\r\n"]
[1.208, "o", "\u001b[1;32m$\u001b[0m prompiler --version\r\n"]
[1.454, "o", "prompiler 0.1.1\r\n"]
[1.238, "o", "\u001b[1;32m$\u001b[0m prompiler --help\r\n"]
[1.462, "o", "\u001b[1m                                                                                \u001b[0m\r\n\u001b[1m \u001b[0m\u001b[1;33mUsage: \u001b[0m\u001b[1mprompiler [OPTIONS] COMMAND [ARGS]...\u001b[0m\u001b[1m                                  \u001b[0m\u001b[1m \u001b[0m\r\n\u001b[1m                                                                                \u001b[0m\r\n"]
[0.001, "o", " prompiler — spec-to-artefact prompt compiler.                                  \r\n                                                                                \r\n"]
[0.001, "o", "\u001b[2m╭─\u001b[0m\u001b[2m Options \u001b[0m\u001b[2m───────────────────────────────────────────────────────────────────\u001b[0m\u001b[2m─╮\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-version\u001b[0m          Show the prompiler version and exit.                      \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36m-\u001b[0m\u001b[1;36m-help\u001b[0m             Show this message and exit.                               \u001b[2m│\u001b[0m\r\n\u001b[2m╰──────────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[0.001, "o", "\u001b[2m╭─\u001b[0m\u001b[2m Commands \u001b[0m\u001b[2m──────────────────────────────────────────────────────────────────\u001b[0m\u001b[2m─╮\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mvalidate\u001b[0m\u001b[1;36m \u001b[0m Validate prompt specs under the given path (load + lint).          \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mcodegen \u001b[0m\u001b[1;36m \u001b[0m Render a spec to a standalone vendored Python module.              \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mserve   \u001b[0m\u001b[1;36m \u001b[0m Run the MCP skeleton HTTP server (P0 healthz only).                \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36meval    \u001b[0m\u001b[1;36m \u001b[0m Run a spec against a fixture and emit metrics reports.             \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mrefine  \u001b[0m\u001b[1;36m \u001b[0m Propose a prompt edit from an eval report (tutor diff to stdout).  \u001b[2m│\u001b[0m\r\n\u001b[2m│\u001b[0m \u001b[1;36mstats   \u001b[0m\u001b[1;36m \u001b[0m Summarise recorded backend usage over a recent time window.        \u001b[2m│\u001b[0m\r\n\u001b[2m╰──────"]
[0.000, "o", "────────────────────────────────────────────────────────────────────────╯\u001b[0m\r\n"]
[0.000, "o", "\r\n"]
[1.243, "o", "\u001b[2m# 2. Write a spec — a single YAML file. Every field needs a description.\u001b[0m\r\n"]
[1.216, "o", "\u001b[1;32m$\u001b[0m cat invoice.yaml\r\n"]
[1.208, "o", "spec_version: 1\r\nname: invoice\r\ntask: extract\r\ndescription: Extract billing details from a single invoice document.\r\nfields:\r\n  - name: vendor_name\r\n    type: string\r\n    required: true\r\n    description: Legal name of the issuing vendor.\r\n  - name: total_amount\r\n    type: decimal\r\n    required: true\r\n    description: Grand total on the invoice in vendor currency.\r\n"]
[1.209, "o", "\u001b[2m# 3. Validate — loads the spec and runs the linter. Exit 0 means lint-clean.\u001b[0m\r\n"]
[1.213, "o", "\u001b[1;32m$\u001b[0m prompiler validate invoice.yaml\r\n"]
[2.685, "o", "\u001b[1;32m$\u001b[0m echo \"exit code: $?\"\r\n"]
[1.210, "o", "exit code: 0\r\n"]
[1.207, "o", "\u001b[2m# 4. Generate — deterministic prompt, Pydantic model, per-backend schema.\u001b[0m\r\n"]
[1.211, "o", "\u001b[1;32m$\u001b[0m prompiler codegen invoice.yaml -o .prompiler/compiled\r\n"]
[1.456, "o", ".prompiler/compiled/invoice.py\r\n"]
[1.247, "o", "\u001b[1;32m$\u001b[0m find .prompiler/compiled -type f | sort\r\n"]
[1.220, "o", ".prompiler/compiled/invoice.py\r\n"]
[1.210, "o", "\u001b[2m# 5. Use it from Python — compile the bundle and inspect it.\u001b[0m\r\n"]
[1.214, "o", "\u001b[1;32m$\u001b[0m python demo.py\r\n"]
[1.338, "o", "spec_hash: abf7aa547e1b13b6356721ffc920923f8638f9e4b5c3b558f78963ff8f712753\r\nprompt (first line): ## Role\r\nmodel: Invoice\r\n"]
[1.224, "o", "\u001b[2m# Run a real extraction with run_sync. Here a scripted backend stands in for a live vendor — no API key, fully reproducible.\u001b[0m\r\n"]
[1.214, "o", "\u001b[1;32m$\u001b[0m python extract.py\r\n"]
[1.325, "o", "vendor: Acme Corp\r\ntotal : 1240.00\r\n"]
[1.224, "o", "\u001b[2m# The orchestrator self-heals one bad response. Here the backend returns an invalid payload first; prompiler feeds the validation error back and the retry succeeds.\u001b[0m\r\n"]
[1.219, "o", "\u001b[1;32m$\u001b[0m python retry.py\r\n"]
[1.330, "o", "recovered after 2 calls -> total: 1240.00\r\n"]
[1.225, "o", "\u001b[2m# Done — install to validated extraction in one loop. Next: examples/, API.md, CLI.md.\u001b[0m\r\n"]
[2.432, "x", "0"]
